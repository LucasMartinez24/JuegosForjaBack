generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // Asegurate de tener tu variable de entorno mapeada
}

model Usuario {
  id                     Int       @id @default(autoincrement())
  username               String    @unique @db.VarChar(50)
  email                  String?   @unique
  passwordHash           String    @map("password_hash")
  rol                    Rol
  dni                    String    @unique @db.VarChar(20)
  nombre                 String    @db.VarChar(100)
  apellido               String    @db.VarChar(100)
  idLocalidad            Int?      @map("id_localidad")
  requiereCambioPassword Boolean   @default(true) @map("requiere_cambio_password")
  
  // Documentación del Representante de la Delegación
  urlDniFrente           String?   @map("url_dni_frente") @db.VarChar(255)
  urlDniDorso            String?   @map("url_dni_dorso") @db.VarChar(255)
  
  equipo                 Equipo?
  localidad              Localidad? @relation(fields: [idLocalidad], references: [id])

  @@index([idLocalidad], map: "usuarios_id_localidad_fkey")
  @@map("usuarios")
}

model Disciplina {
  id      Int              @id @default(autoincrement())
  nombre  String           @unique @db.VarChar(100)
  tipo    TipoDisciplina
  equipos Equipo[]
  pruebas PruebaEspecifica[]

  @@map("disciplinas")
}

model PruebaEspecifica {
  id                  Int                         @id @default(autoincrement())
  idDisciplina        Int                         @map("id_disciplina")
  nombrePrueba        String                      @map("nombre_prueba") @db.VarChar(150)
  genero              Genero
  anioNacimientoMin   Int                         @map("anio_nacimiento_min")
  anioNacimientoMax   Int                         @map("anio_nacimiento_max")
  maxJugadores        Int                         @map("max_jugadores")
  requierePeso        Boolean                     @default(false) @map("requiere_peso")
  pesoMaximo          Decimal?                    @map("peso_maximo") @db.Decimal(5, 2)
  pesoMinimo          Decimal?                    @map("peso_minimo") @db.Decimal(5, 2)
  subCategoria        String?                     @map("sub_categoria") @db.VarChar(100)
  deportistas         Deportista[]                @relation("PruebaPrincipal")
  deportistasComoAdic DeportistaPruebaAdicional[] @relation("PruebaAdicional")
  disciplina          Disciplina                  @relation(fields: [idDisciplina], references: [id], onDelete: Cascade)

  @@index([idDisciplina], map: "pruebas_especificas_id_disciplina_fkey")
  @@map("pruebas_especificas")
}

model Equipo {
  id           String       @id @default(cuid())
  nombre       String
  siglas       String
  municipio    String
  idDisciplina Int          @map("id_disciplina")
  usuarioId    Int          @unique @map("usuario_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deportistas  Deportista[]
  disciplina   Disciplina   @relation(fields: [idDisciplina], references: [id])
  usuario      Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([idDisciplina], map: "equipo_id_disciplina_fkey")
  @@map("equipo")
}

model Deportista {
  id                 String                      @id @default(uuid())
  idEquipo           String                      @map("id_equipo")
  idPrueba           Int                         @map("id_prueba")
  dni                String                      @db.VarChar(20)
  nombre             String                      @db.VarChar(100)
  apellido           String                      @db.VarChar(100)
  fechaNacimiento    DateTime                    @map("fecha_nacimiento")
  genero             Genero
  deporteAsignado    String                      @map("deporte_assigned") @db.VarChar(100)
  whatsapp           String?                     @db.VarChar(30)
  pesoKg             Decimal?                    @map("peso_kg") @db.Decimal(5, 2)
  alturaCm           Int?                        @map("altura_cm")
  estado             EstadoInscripcion           @default(PENDIENTE)
  motivoRechazo      String?                     @map("motivo_rechazo") @db.Text
  urlDniFrente       String                      @map("url_dni_frente") @db.VarChar(255)
  urlDniDorso        String                      @map("url_dni_dorso") @db.VarChar(255)
  urlFichaMedica     String                      @map("url_ficha_medica") @db.VarChar(255)
  urlCud             String?                     @map("url_cud") @db.VarChar(255)
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")

  equipo             Equipo                      @relation(fields: [idEquipo], references: [id], onDelete: Cascade)
  prueba             PruebaEspecifica            @relation("PruebaPrincipal", fields: [idPrueba], references: [id], onDelete: Cascade)
  pruebasAdicionales DeportistaPruebaAdicional[]

  @@unique([dni, idEquipo])
  @@index([idEquipo])
  @@index([idPrueba])
  @@map("deportistas")
}

// 🚀 NUEVA TABLA INTERMEDIA PERFECTAMENTE ENLAZADA
model DeportistaPruebaAdicional {
  id           Int              @id @default(autoincrement())
  idDeportista String           @map("id_deportista")
  idPrueba     Int              @map("id_prueba")
  deportista   Deportista       @relation(fields: [idDeportista], references: [id], onDelete: Cascade)
  prueba       PruebaEspecifica @relation("PruebaAdicional", fields: [idPrueba], references: [id], onDelete: Cascade)

  @@unique([idDeportista, idPrueba])
  @@index([idPrueba])
  @@map("deportista_pruebas_adicionales")
}

model Localidad {
  id      Int               @id @default(autoincrement())
  nombre  String            @unique @db.VarChar(100)
  tipo    TipoLocalidad
  tokens  TokenInvitacion[]
  usuarios Usuario[]

  @@map("localidades")
}

model TokenInvitacion {
  id          Int       @id @default(autoincrement())
  token       String    @unique @db.VarChar(64)
  idLocalidad Int       @map("id_localidad")
  utilizado   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  localidad   Localidad @relation(fields: [idLocalidad], references: [id], onDelete: Cascade)

  @@index([idLocalidad], map: "tokens_invitacion_id_localidad_fkey")
  @@map("tokens_invitacion")
}

enum Rol {
  ADMIN
  MUNICIPIO
  EQUIPO
}

enum TipoDisciplina {
  CONVENCIONAL
  ADAPTADO
}

enum TipoLocalidad {
  MUNICIPALIDAD
  COMISION_MUNICIPAL
}

enum Genero {
  MASCULINO
  FEMENINO
  MIXTO
}

enum EstadoInscripcion {
  PENDIENTE
  APROBADO
  RECHAZADO
}